# Copie este arquivo para .env e preencha com sua chave da API da Anthropic
# Obtenha a chave em: https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: porta do servidor (padrão 3000)
# PORT=3000

# Opcional: modelo Claude a usar (padrão claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8
