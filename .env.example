# ============================================================
# Escolha do provedor de IA para análise das consultas
# ============================================================
# "anthropic" — Claude API (pago, melhor qualidade clínica)  [padrão]
# "ollama"    — modelo local gratuito rodando no seu computador
IA_PROVIDER=anthropic

# ------------------------------------------------------------
# Opção 1: Claude (IA_PROVIDER=anthropic)
# ------------------------------------------------------------
# Obtenha a chave em: https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo Claude a usar (padrão claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# ------------------------------------------------------------
# Opção 2: Ollama — grátis e local (IA_PROVIDER=ollama)
# ------------------------------------------------------------
# 1. Instale o Ollama: https://ollama.com/download
# 2. Baixe um modelo:  ollama pull llama3.1:8b
# 3. Defina IA_PROVIDER=ollama acima
#
# Opcional: modelo local (padrão llama3.1:8b; alternativas: qwen2.5:7b, qwen2.5:14b)
# OLLAMA_MODEL=llama3.1:8b
# Opcional: endereço do Ollama (padrão http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Opcional: porta do servidor (padrão 3000)
# PORT=3000
